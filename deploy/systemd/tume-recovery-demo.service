[Unit]
Description=TUMe disposable recovery pilot service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 -I /usr/local/libexec/tume-recovery-demo.py
DynamicUser=yes
RuntimeDirectory=tume-recovery-demo
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=6s
TimeoutStopSec=2s
Restart=no
